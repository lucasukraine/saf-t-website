---
// /en/blog/ — English counterpart of /blog/. The articles themselves are
// published in Ukrainian only (owner's decision); this page says so up front,
// tells English readers what each article covers (titleEn) and links to the
// Ukrainian originals.
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || b.data.order - a.data.order
);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://saftconnector.com';
const fmt = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

const title = 'SAF-T UA guides (in Ukrainian) | SAF-T Connector';
const description = 'Practical SAF-T UA guides from the LUCAS team: who submits, file structure, XSD validation, ERP integration. Articles are in Ukrainian; summaries in English.';

const listSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl}/en/blog/#page`,
      url: `${siteUrl}/en/blog/`,
      name: 'SAF-T UA guides — SAF-T Connector',
      description: 'Guides on SAF-T UA requirements, file structure, validation, data preparation and ERP integration. The articles are published in Ukrainian.',
      inLanguage: 'en',
      isPartOf: { '@id': `${siteUrl}/#website` },
      hasPart: posts.map((p) => ({
        '@type': 'Article',
        headline: p.data.title,
        alternativeHeadline: p.data.titleEn,
        inLanguage: 'uk',
        url: `${siteUrl}/blog/${p.id}/`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'SAF-T Connector', item: `${siteUrl}/en/` },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/en/blog/` },
      ],
    },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  theme="light"
  schemaExtra={listSchema}
>
  <section class="blog-index">
    <div class="container">

      <div class="sect-rule">
        <span class="sect-no">Blog</span>
        <span class="sect-label">SAF-T UA in practice</span>
      </div>

      <div class="sect-cols">
        <h1 class="sect-h2">SAF-T UA guides and insights</h1>
        <p class="sect-lead">
          Requirements and deadlines, file structure, validation, preparing accounting
          data and ERP integration: practical guides from the LUCAS team, the developers
          of SAF-T Connector.
        </p>
      </div>

      <aside class="lang-note" aria-labelledby="lang-note-h">
        <span class="lang-note-tag" aria-hidden="true">UA</span>
        <div class="lang-note-body">
          <p class="lang-note-h" id="lang-note-h">Our articles are published in Ukrainian only</p>
          <p>
            They are written for accounting, tax and IT teams in Ukraine and track Ukrainian
            regulation closely, so we keep them in the original language rather than risk an
            imprecise translation. Each entry below says in English what the article covers.
            Your browser's built-in translation is fine for a first read; before acting on
            anything, <a href="/en/#contact">talk to our team</a> and we'll walk you through it
            in English.
          </p>
        </div>
      </aside>

      <ul class="blog-list">
        {posts.map((post, i) => (
          <li>
            <a href={`/blog/${post.id}/`} class="blog-row" hreflang="uk">
              <span class="blog-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="blog-main">
                <span class="blog-label">Article in Ukrainian</span>
                <span class="blog-title">{post.data.titleEn}</span>
                <span class="blog-orig" lang="uk">{post.data.title}</span>
              </span>
              <span class="blog-side">
                <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
                <span class="blog-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </section>
</BaseLayout>

<style>
.blog-index { padding: 136px 0 112px; }

/* Language notice — same card language as the article CTA box */
.lang-note {
  display: flex;
  gap: 18px;
  align-items: flex-start;
  background: var(--surface);
  border: 1px solid var(--line-strong);
  border-left: 2px solid var(--accent);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  padding: 22px 26px;
  margin-bottom: 48px;
  max-width: 820px;
}
.lang-note-tag {
  flex: none;
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  color: var(--accent-text);
  border: 1px solid var(--line-strong);
  border-radius: 6px;
  padding: 5px 8px;
  margin-top: 2px;
}
.lang-note-body { display: flex; flex-direction: column; gap: 8px; }
.lang-note-h {
  font-family: var(--display);
  font-weight: 600;
  font-size: 17px;
  letter-spacing: -0.015em;
  color: var(--ink);
}
.lang-note-body p:not(.lang-note-h) {
  font-family: var(--body);
  font-size: 14.5px;
  line-height: 1.7;
  color: var(--ink-soft);
}
.lang-note a {
  color: var(--accent-text);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.blog-list {
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid var(--line-strong);
}
.blog-row {
  display: grid;
  grid-template-columns: 56px 1fr 180px;
  gap: 28px;
  align-items: start;
  padding: 30px 0;
  border-bottom: 1px solid var(--line);
}
.blog-no {
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .08em;
  color: var(--accent-text);
  padding-top: 4px;
}
.blog-main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.blog-label {
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--ink-mute);
}
.blog-title {
  font-family: var(--display);
  font-weight: 600;
  font-size: clamp(19px, 1.8vw, 24px);
  letter-spacing: -0.022em;
  line-height: 1.2;
  color: var(--ink);
  transition: color .2s var(--ease);
}
.blog-orig {
  font-family: var(--body);
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink-soft);
  max-width: 68ch;
}
.blog-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
  padding-top: 4px;
}
.blog-side time {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: .04em;
  color: var(--ink-mute);
  white-space: nowrap;
}
.blog-arrow {
  color: var(--ink-mute);
  font-size: 18px;
  transition: transform .2s var(--ease), color .2s var(--ease);
}
.blog-row:hover .blog-title { color: var(--accent-text); }
.blog-row:hover .blog-arrow { color: var(--accent-text); transform: translateX(4px); }

@media (max-width: 900px) {
  .blog-row { grid-template-columns: 40px 1fr; }
  .blog-side { grid-column: 2; flex-direction: row; align-items: baseline; gap: 14px; padding-top: 2px; }
}
@media (max-width: 720px) {
  .blog-index { padding: 104px 0 72px; }
  .blog-row { grid-template-columns: 1fr; gap: 8px; padding: 24px 0; }
  .blog-no { display: none; }
  .lang-note { padding: 18px 18px; gap: 14px; margin-bottom: 36px; }
}
</style>
