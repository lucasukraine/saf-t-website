---
// Footer.astro — SAF-T Connector
import { getLang, homePath, blogPath } from '../i18n';

const currentYear = new Date().getFullYear();
const lang = getLang(Astro.url);
const home = homePath(lang);
// Legal names are Ukrainian in both versions; mark them on English pages
const nameLang = lang === 'en' ? 'uk' : undefined;

const t = {
  uk: {
    homeAria: 'SAF-T Connector — на головну',
    tagline: 'Формування XML-файлу та XSD-валідація відповідно до вимог е-аудиту ДПС України.',
    legal: [['Розробка', 'ТОВ САФ-Т Коннектор'], ['Впровадження', 'ТОВ Лукас Аудит']],
    product: 'Продукт',
    productLinks: [
      ['#explainer', 'Що таке SAF-T'],
      ['#benefits', 'Можливості'],
      ['#erp', 'ERP-системи'],
      ['#how-it-works', 'Реалізація'],
      ['#validation', 'Валідація XML'],
    ],
    resources: 'Ресурси',
    blog: 'Блог',
    guides: [
      ['/blog/shcho-take-saf-t-ua/', 'Гайд по SAF-T UA'],
      ['/blog/hto-podaye-saf-t-ua/', 'Хто подає SAF-T'],
      ['/blog/validatsiia-saf-t-ua/', 'Валідація XSD'],
    ],
    guidesLang: undefined,
    contact: "Зв'язок",
    demo: 'Запит на демо',
    reveal: 'Показати email',
    phone: 'Телефон',
    phoneDisplay: '+38 (044) 344-79-15',
    address: 'Адреса',
    addressVal: 'Київ, БЦ Гулівер, вежа А, 17-й поверх',
    rights: 'Усі права захищені.',
    extAria: 'lucasua.com — зовнішній сайт',
  },
  en: {
    homeAria: 'SAF-T Connector — home',
    tagline: 'XML file generation and XSD validation in line with the e-audit requirements of the State Tax Service of Ukraine.',
    // Exact Ukrainian legal names until official English names are confirmed
    legal: [['Product', 'ТОВ САФ-Т Коннектор'], ['Implementation', 'ТОВ Лукас Аудит']],
    product: 'Product',
    productLinks: [
      ['#explainer', 'What is SAF-T'],
      ['#benefits', 'Capabilities'],
      ['#erp', 'ERP systems'],
      ['#how-it-works', 'Implementation'],
      ['#validation', 'XML validation'],
    ],
    resources: 'Resources',
    blog: 'Blog',
    // Ukrainian-only articles — the link text says so
    guides: [
      ['/blog/shcho-take-saf-t-ua/', 'SAF-T UA guide (UA)'],
      ['/blog/hto-podaye-saf-t-ua/', 'Who submits SAF-T (UA)'],
      ['/blog/validatsiia-saf-t-ua/', 'XSD validation (UA)'],
    ],
    guidesLang: 'uk',
    contact: 'Contact',
    demo: 'Demo requests',
    reveal: 'Show email',
    phone: 'Phone',
    phoneDisplay: '+380 44 344 7915',
    address: 'Address',
    addressVal: 'Gulliver Business Center, Tower A, 17th floor, Kyiv, Ukraine',
    rights: 'All rights reserved.',
    extAria: 'lucasua.com — external website',
  },
}[lang];
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        <a href={home} class="footer-logo" aria-label={t.homeAria}>
          <img src={`${import.meta.env.BASE_URL}logo-white.svg`} class="footer-logo-img" alt="" width="111" height="30" />
        </a>
        <p class="footer-tagline">
          {t.tagline}
        </p>
        <p class="footer-legal">
          {t.legal[0][0]}: <span lang={nameLang}>{t.legal[0][1]}</span><br>
          {t.legal[1][0]}: <span lang={nameLang}>{t.legal[1][1]}</span>
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <p class="footer-col-label">{t.product}</p>
        <ul>
          {t.productLinks.map(([hash, label]) => <li><a href={`${home}${hash}`}>{label}</a></li>)}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <p class="footer-col-label">{t.resources}</p>
        <ul>
          <li><a href={blogPath(lang)}>{t.blog}</a></li>
          {t.guides.map(([href, label]) => <li><a href={href} hreflang={t.guidesLang}>{label}</a></li>)}
          <li><a href={`${home}#faq`}>FAQ</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer-contact">
        <p class="footer-col-label">{t.contact}</p>
        <div class="footer-contact-row">
          <span class="footer-contact-lbl">{t.demo}</span>
          <button type="button" class="footer-contact-val email-reveal" data-user="info" data-domain="lucasua.com">{t.reveal}</button>
        </div>
        <div class="footer-contact-row">
          <span class="footer-contact-lbl">{t.phone}</span>
          <a href="tel:+380443447915" class="footer-contact-val">{t.phoneDisplay}</a>
        </div>
        <div class="footer-contact-row">
          <span class="footer-contact-lbl">{t.address}</span>
          <span class="footer-contact-val">{t.addressVal}</span>
        </div>
      </div>
    </div>

    <div class="footer-bot">
      <span class="footer-bot-copy">© {currentYear} <span lang={nameLang}>ТОВ "САФ-Т Коннектор". ТОВ "Лукас Аудит".</span> {t.rights}</span>
      <a href="https://www.lucasua.com" target="_blank" rel="noopener" class="footer-bot-accent" aria-label={t.extAria}>lucasua.com →</a>
    </div>
  </div>
</footer>
