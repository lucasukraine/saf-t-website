---
// SaftHowItWorks.astro — Implementation process (3 steps)
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
const t = {
  uk: {
    label: 'Реалізація',
    h2: 'Етапи впровадження',
    lead: 'Типовий термін впровадження — приблизно 3–4 місяці залежно від кількості юридичних осіб, складності облікової системи, якості даних та доступності IT-команди клієнта.',
    stepsAria: 'Кроки впровадження',
    s1h: 'Аналіз та мапінг',
    s1p: 'Аналізуємо якість і достатність облікових даних клієнта: чи вистачає наявних даних, де є прогалини. Розробляємо мапінг — відповідність між обліковою структурою клієнта та елементами SAF-T UA. Узгоджуємо джерела даних.',
    s1tags: ['Аналіз даних', 'Розробка мапінгу', 'Узгодження джерел'],
    s1card: 'Аналіз даних',
    s1chip: '✓ Готово',
    s1items: ['Аналіз якості даних', 'Визначення джерел даних', 'Розробка мапінгу', 'Узгодження прогалин'],
    s2h: 'Налаштування та інтеграція',
    s2p: 'Налаштовуємо програмне забезпечення: логіку трансформації, підключення до джерел даних. Розгортаємо систему на інфраструктурі клієнта, налаштовуємо доступи та авторизації. Погоджуємо з IT-командою підхід до вивантаження даних.',
    s2tags: ['Налаштування трансформації', 'Інтеграція з ERP', 'Розгортання'],
    s2card: 'Генерація XML',
    s3h: 'Тестування та запуск',
    s3p: 'Генеруємо тестові файли на реальних даних. Виконуємо XSD-валідацію, математичні та міжсекційні перевірки. Усуваємо виявлені проблеми з даними та мапінгом. Навчаємо користувачів і передаємо процес команді клієнта.',
    s3tags: ['XSD-валідація', 'Тестування на реальних даних', 'Навчання та запуск'],
    s3card: 'XSD-валідація',
    s3chip: 'Пройдено',
    s3items: ['Структура XSD — відповідає', 'Математичні контролі — пройдено', 'Міжсекційні перевірки — пройдено', 'Типи даних — без порушень'],
    s3file: 'SAF-T_UA_звітний_період.xml',
    tlLabel: 'Типовий термін проєкту',
    tlTotal: '~3–4 місяці',
    tlAria: 'Часова шкала проєкту на 4 місяці: аналіз і мапінг — приблизно 1 місяць; налаштування — приблизно 1,5 місяця; тестування і запуск — приблизно 1 місяць. Загалом 3–4 місяці залежно від складності.',
    month: 'міс.',
    rows: ['Аналіз і мапінг', 'Налаштування', 'Тестування і запуск'],
    durs: ['~1 міс.', '~1,5 міс.', '~1 міс.'],
  },
  en: {
    label: 'Implementation',
    h2: 'Implementation stages',
    lead: 'A typical implementation takes about 3–4 months, depending on the number of legal entities, the complexity of the accounting system, data quality and the availability of the client\'s IT team.',
    stepsAria: 'Implementation steps',
    s1h: 'Analysis and mapping',
    s1p: 'We assess the quality and completeness of the client\'s accounting data: whether the existing data is sufficient and where the gaps are. We build the mapping, which links the client\'s accounting structure to the elements of SAF-T UA, and agree on the data sources.',
    s1tags: ['Data analysis', 'Mapping design', 'Agreement on data sources'],
    s1card: 'Data analysis',
    s1chip: '✓ Done',
    s1items: ['Data quality assessment', 'Data sources identified', 'Mapping designed', 'Resolving gaps'],
    s2h: 'Configuration and integration',
    s2p: 'We configure the software: transformation logic and connections to the data sources. We deploy the system on the client\'s infrastructure and set up access rights and authorizations. The data export approach is agreed with the client\'s IT team.',
    s2tags: ['Transformation setup', 'ERP integration', 'Deployment'],
    s2card: 'XML generation',
    s3h: 'Testing and go-live',
    s3p: 'We generate test files on real data and run XSD validation along with arithmetic checks and cross-checks between file sections. We fix the data and mapping issues that surface, train the users and hand the process over to the client\'s team.',
    s3tags: ['XSD validation', 'Testing on real data', 'Training and go-live'],
    s3card: 'XSD validation',
    s3chip: 'Passed',
    s3items: ['XSD structure — compliant', 'Arithmetic checks — passed', 'Section cross-checks — passed', 'Data types — no violations'],
    s3file: 'SAF-T_UA_reporting_period.xml',
    tlLabel: 'Typical project timeline',
    tlTotal: '~3–4 months',
    tlAria: 'Four-month project timeline: analysis and mapping, about 1 month; configuration, about 1.5 months; testing and go-live, about 1 month. 3–4 months in total, depending on complexity.',
    month: 'Month',
    rows: ['Analysis and mapping', 'Configuration', 'Testing and go-live'],
    durs: ['~1 mo.', '~1.5 mo.', '~1 mo.'],
  },
}[lang];

const ticks = [1, 2, 3, 4].map((n) => `${t.month} ${n}`);
---

<section class="s-hiw" id="how-it-works" aria-labelledby="hiw-h2">
  <div class="container">

    <div class="sect-rule">
      <span class="sect-no">04</span>
      <span class="sect-label">{t.label}</span>
    </div>

    <div class="sect-cols">
      <h2 id="hiw-h2" class="sect-h2">{t.h2}</h2>
      <p class="sect-lead">
        {t.lead}
      </p>
    </div>

    <!-- Steps -->
    <ol class="hiw-steps" aria-label={t.stepsAria}>

      <li class="hiw-step">
        <div class="hiw-step-num" aria-hidden="true">01</div>
        <div class="hiw-step-body">
          <h3 class="hiw-step-h3">{t.s1h}</h3>
          <p>
            {t.s1p}
          </p>
          <div class="hiw-tags">
            {t.s1tags.map((tag) => <span class="hiw-tag">{tag}</span>)}
          </div>
        </div>
        <div class="hiw-step-visual" aria-hidden="true">
          <div class="hsv-card">
            <div class="hsv-head">
              <span class="hsv-lbl">{t.s1card}</span>
              <span class="hsv-chip done">{t.s1chip}</span>
            </div>
            <div class="hsv-items">
              <div class="hsv-item">
                <span class="hsv-icon check">✓</span>
                <span>{t.s1items[0]}</span>
              </div>
              <div class="hsv-item">
                <span class="hsv-icon check">✓</span>
                <span>{t.s1items[1]}</span>
              </div>
              <div class="hsv-item">
                <span class="hsv-icon check">✓</span>
                <span>{t.s1items[2]}</span>
              </div>
              <div class="hsv-item active">
                <span class="hsv-icon spin-icon">⟳</span>
                <span>{t.s1items[3]}</span>
              </div>
            </div>
          </div>
        </div>
      </li>

      <li class="hiw-step">
        <div class="hiw-step-num" aria-hidden="true">02</div>
        <div class="hiw-step-body">
          <h3 class="hiw-step-h3">{t.s2h}</h3>
          <p>
            {t.s2p}
          </p>
          <div class="hiw-tags">
            {t.s2tags.map((tag) => <span class="hiw-tag">{tag}</span>)}
          </div>
        </div>
        <div class="hiw-step-visual" aria-hidden="true">
          <div class="hsv-card">
            <div class="hsv-head">
              <span class="hsv-lbl">{t.s2card}</span>
              <span class="hsv-chip prog">68%</span>
            </div>
            <div class="hsv-xml-blocks">
              <div class="hsv-block done"><span>Header</span><span class="hsv-ok">✓</span></div>
              <div class="hsv-block done"><span>MasterFiles</span><span class="hsv-ok">✓</span></div>
              <div class="hsv-block done"><span>GLEntries</span><span class="hsv-ok">✓</span></div>
              <div class="hsv-block active"><span>SourceDocs</span><span class="hsv-pend">···</span></div>
              <div class="hsv-block pend"><span>TaxDiff</span><span class="hsv-pend">—</span></div>
            </div>
          </div>
        </div>
      </li>

      <li class="hiw-step">
        <div class="hiw-step-num" aria-hidden="true">03</div>
        <div class="hiw-step-body">
          <h3 class="hiw-step-h3">{t.s3h}</h3>
          <p>
            {t.s3p}
          </p>
          <div class="hiw-tags">
            {t.s3tags.map((tag) => <span class="hiw-tag">{tag}</span>)}
          </div>
        </div>
        <div class="hiw-step-visual" aria-hidden="true">
          <div class="hsv-card">
            <div class="hsv-head">
              <span class="hsv-lbl">{t.s3card}</span>
              <span class="hsv-chip done">{t.s3chip}</span>
            </div>
            <div class="hsv-items">
              {t.s3items.map((item) => (
                <div class="hsv-item">
                  <span class="hsv-icon check">✓</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
            <div class="hsv-export">
              <span class="hsv-export-icon">↓</span>
              <span>{t.s3file}</span>
              <span class="hsv-export-size">XML</span>
            </div>
          </div>
        </div>
      </li>

    </ol>

    <!-- Timeline — mini-Gantt on a month scale -->
    <div class="hiw-timeline">
      <div class="hiw-tl-head">
        <span class="hiw-tl-label">{t.tlLabel}</span>
        <span class="hiw-tl-total">{t.tlTotal}</span>
      </div>

      <div
        class="hg"
        role="img"
        aria-label={t.tlAria}
      >
        <div class="hg-lines" aria-hidden="true">
          <i style="left:0"></i><i style="left:25%"></i><i style="left:50%"></i><i style="left:75%"></i><i style="left:100%"></i>
        </div>

        <div class="hg-ruler" aria-hidden="true">
          <span></span>
          <div class="hg-ticks">
            {ticks.map((tk) => <span class="hg-tick">{tk}</span>)}
          </div>
          <span></span>
        </div>

        <div class="hg-row" aria-hidden="true">
          <span class="hg-name"><b>01</b>{t.rows[0]}</span>
          <div class="hg-track">
            <div class="hg-bar" style="left:0; width:25%"></div>
          </div>
          <span class="hg-dur">{t.durs[0]}</span>
        </div>

        <div class="hg-row" aria-hidden="true">
          <span class="hg-name"><b>02</b>{t.rows[1]}</span>
          <div class="hg-track">
            <div class="hg-bar accent" style="left:25%; width:37.5%"></div>
          </div>
          <span class="hg-dur">{t.durs[1]}</span>
        </div>

        <div class="hg-row" aria-hidden="true">
          <span class="hg-name"><b>03</b>{t.rows[2]}</span>
          <div class="hg-track">
            <div class="hg-bar" style="left:62.5%; width:25%"></div>
            <div class="hg-tail" style="left:87.5%; width:12.5%"></div>
          </div>
          <span class="hg-dur">{t.durs[2]}</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
/* Steps — editorial rows with oversized numerals */
.hiw-steps {
  list-style: none;
  padding: 0; margin: 0 0 72px;
  display: flex; flex-direction: column;
}
.hiw-step {
  display: grid;
  grid-template-columns: 120px 1.1fr .9fr;
  gap: 48px;
  padding: 56px 0;
  border-top: 1px solid var(--line);
  align-items: start;
}
.hiw-step:last-child { border-bottom: 1px solid var(--line); }

.hiw-step-num {
  font-family: var(--display);
  font-size: clamp(40px, 3.6vw, 56px);
  font-weight: 400;
  letter-spacing: -0.03em;
  line-height: .9;
  color: transparent;
  -webkit-text-stroke: 1px var(--ink-mute);
  padding-top: 6px;
}

.hiw-step-body { display: flex; flex-direction: column; gap: 16px; }
.hiw-step-h3 {
  font-family: var(--display);
  font-weight: 600;
  font-size: clamp(21px, 1.9vw, 27px);
  letter-spacing: -0.025em;
  line-height: 1.15;
  color: var(--ink);
}
.hiw-step-body p {
  font-family: var(--body);
  font-size: 15px;
  line-height: 1.75;
  color: var(--ink-soft);
  max-width: 54ch;
}

.hiw-tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 6px;
}
.hiw-tag {
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink-soft);
  border: 1px solid var(--line-strong);
  border-radius: 6px;
  padding: 5px 10px;
}

/* Step visuals — chrome family */
.hsv-card {
  background: var(--chrome);
  border: 1px solid var(--chrome-line);
  border-radius: var(--radius-sm);
  padding: 0;
  overflow: hidden;
  box-shadow: 0 14px 40px -16px rgba(2,4,10,.5);
  max-width: 430px;
  justify-self: end;
  width: 100%;
}
.hsv-head {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 11px 16px;
  background: rgba(255,255,255,.025);
  border-bottom: 1px solid var(--chrome-line);
}
.hsv-lbl {
  font-family: var(--mono); font-size: 9.5px; font-weight: 600;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: rgba(226,235,250,.45);
}
.hsv-chip {
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 5px;
}
.hsv-chip.done { color: var(--ok); border: 1px solid rgba(52,209,120,.28); background: rgba(52,209,120,.08); }
.hsv-chip.prog { color: var(--accent-hi); border: 1px solid rgba(3,169,244,.30); background: rgba(3,169,244,.08); }

.hsv-items { display: flex; flex-direction: column; gap: 9px; padding: 14px 16px; }
.hsv-item {
  display: flex; align-items: center; gap: 10px;
  font-family: var(--body); font-size: 12.5px;
  color: rgba(226,235,250,.72); line-height: 1.4;
}
.hsv-item.active { color: var(--accent-hi); }

.hsv-icon { font-size: 11px; font-weight: 700; width: 14px; text-align: center; flex: none; }
.hsv-icon.check { color: var(--ok); }
.hsv-icon.spin-icon { color: var(--accent-hi); animation: spin .9s linear infinite; }

/* XML blocks */
.hsv-xml-blocks {
  display: flex; gap: 7px; flex-wrap: wrap;
  padding: 16px;
}
.hsv-block {
  display: flex; align-items: center; gap: 7px;
  padding: 7px 11px;
  border-radius: 6px;
  font-family: var(--mono); font-size: 11px; font-weight: 600;
  border: 1px solid var(--chrome-line);
  color: rgba(226,235,250,.45);
}
.hsv-block.done   { border-color: rgba(52,209,120,.25); color: rgba(226,235,250,.80); }
.hsv-block.active { border-color: rgba(3,169,244,.35);  color: var(--accent-hi); }
.hsv-block.pend   { opacity: .4; }
.hsv-ok   { color: var(--ok); }
.hsv-pend { color: rgba(226,235,250,.40); }

/* Export row */
.hsv-export {
  display: flex; align-items: center; gap: 9px;
  padding: 11px 16px;
  border-top: 1px solid var(--chrome-line);
  font-family: var(--mono); font-size: 11px;
  color: rgba(226,235,250,.85);
  font-weight: 600;
}
.hsv-export-icon { color: var(--accent-hi); font-size: 13px; font-weight: 700; }
.hsv-export-size { color: rgba(226,235,250,.35); margin-left: auto; }

/* Timeline — mini-Gantt on a 4-month scale */
.hiw-timeline {
  --hg-name: 250px;
  --hg-dur: 88px;
  border-top: 1px solid var(--line-strong);
  padding-top: 22px;
}
.hiw-tl-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 28px;
}
.hiw-tl-label {
  font-family: var(--mono); font-size: 10px; font-weight: 600;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-mute);
}
.hiw-tl-total {
  font-family: var(--display); font-size: 19px; font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink);
}

.hg { position: relative; }

/* Month verticals — over the track area only */
.hg-lines {
  position: absolute;
  left: var(--hg-name);
  right: var(--hg-dur);
  top: 26px;
  bottom: 4px;
  pointer-events: none;
}
.hg-lines i {
  position: absolute;
  top: 0; bottom: 0;
  width: 1px;
  background: var(--line);
}

/* Ruler */
.hg-ruler {
  display: grid;
  grid-template-columns: var(--hg-name) 1fr var(--hg-dur);
  margin-bottom: 10px;
}
.hg-ticks {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.hg-tick {
  font-family: var(--mono);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--ink-mute);
  padding-left: 9px;
}

/* Rows */
.hg-row {
  display: grid;
  grid-template-columns: var(--hg-name) 1fr var(--hg-dur);
  align-items: center;
  min-height: 46px;
}
.hg-name {
  display: inline-flex;
  align-items: baseline;
  gap: 12px;
  font-family: var(--body);
  font-size: 13.5px;
  font-weight: 600;
  color: var(--ink);
  padding-right: 24px;
}
.hg-name b {
  font-family: var(--mono);
  font-size: 10.5px;
  font-weight: 600;
  color: var(--accent-text);
}
.hg-dur {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-mute);
  text-align: right;
}

.hg-track {
  position: relative;
  height: 46px;
}
.hg-bar {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  height: 14px;
  border-radius: 7px;
  background: var(--line-strong);
  border: 1px solid var(--line-strong);
}
.hg-bar.accent {
  background: linear-gradient(90deg, #33b4f5, #0295d8);
  border-color: transparent;
  box-shadow: 0 2px 14px rgba(3,169,244,.32);
}
/* Flex-range tail: hatched continuation into month 4 */
.hg-tail {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  height: 14px;
  border-radius: 0 7px 7px 0;
  background: repeating-linear-gradient(
    -55deg,
    var(--line-strong) 0px,
    var(--line-strong) 1px,
    transparent 1px,
    transparent 6px
  );
  opacity: .8;
}

@media (max-width: 1080px) {
  .hiw-step { grid-template-columns: 64px 1fr; gap: 28px; padding: 44px 0; }
  .hiw-step-visual { display: none; }
  .hiw-step-num { font-size: 34px; }
  .hiw-timeline { --hg-name: 200px; --hg-dur: 72px; }
}
@media (max-width: 720px) {
  .hiw-step { grid-template-columns: 1fr; gap: 14px; padding: 36px 0; }
  .hiw-step-num { font-size: 30px; padding-top: 0; }
  .hiw-steps { margin-bottom: 56px; }

  /* Gantt: name+duration above the track, full-width scale */
  .hiw-timeline { --hg-name: 0px; --hg-dur: 0px; }
  .hg-lines { top: 24px; }
  .hg-ruler { grid-template-columns: 1fr; }
  .hg-ruler > span { display: none; }
  .hg-row {
    grid-template-columns: 1fr auto;
    grid-template-areas: "name dur" "track track";
    row-gap: 0;
    padding: 8px 0 2px;
  }
  .hg-name  { grid-area: name; padding-right: 0; }
  .hg-dur   { grid-area: dur; }
  .hg-track { grid-area: track; height: 30px; }
}

@media (prefers-reduced-motion: reduce) {
  .hsv-icon.spin-icon { animation: none; }
}
</style>
