---
// SaftFaq.astro — FAQ accordion with AEO-optimized Q&A structure
// Question text is in the DOM for crawlers and AI answer engines.
import { getLang } from '../i18n';
import { faqs } from '../data/faq';

const lang = getLang(Astro.url);
// Non-breaking hyphen keeps "SAF-T" from wrapping as "SAF-" / "T" in body
// copy; the JSON-LD built from the same data keeps the plain hyphen.
const items = faqs[lang].map((f) => ({ q: f.q, a: f.a.replace(/SAF-T/g, 'SAF\u2011T') }));

const t = {
  uk: {
    label: 'Запитання та відповіді',
    h2: 'Відповіді на ключові питання',
    sub: 'Про стандартний аудиторський файл, вимоги ДПС та впровадження нашого рішення — стисло і по суті.',
    more: 'Не знайшли відповіді?',
    write: 'Напишіть нам',
  },
  en: {
    label: 'Questions and answers',
    h2: 'Answers to the key questions',
    sub: 'The standard audit file, STS requirements and how our solution is implemented — briefly and to the point.',
    more: 'Didn\'t find your answer?',
    write: 'Get in touch',
  },
}[lang];
---

<section class="s-faq" id="faq" aria-labelledby="faq-h2">
  <div class="container">

    <div class="sect-rule">
      <span class="sect-no">07</span>
      <span class="sect-label">{t.label}</span>
    </div>

    <div class="faq-layout">

      <div class="faq-intro">
        <h2 id="faq-h2" class="sect-h2">
          {t.h2}
        </h2>
        <p class="faq-sub">
          {t.sub}
          {t.more} <a href="#contact">{t.write}</a>.
        </p>
      </div>

      <div class="faq-list" role="list">
        {items.map((item, i) => (
          <div class="faq-item" role="listitem">
            <button
              class="faq-q"
              type="button"
              aria-expanded="false"
              aria-controls={`faq-a-${i}`}
              id={`faq-q-${i}`}
            >
              <span class="faq-q-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q-text">{item.q}</span>
            </button>
            <div
              class="faq-a"
              id={`faq-a-${i}`}
              role="region"
              aria-labelledby={`faq-q-${i}`}
            >
              <div class="faq-a-inner">{item.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (() => {
    const items = document.querySelectorAll('.faq-item');
    items.forEach(item => {
      const btn = item.querySelector('.faq-q');
      const ans = item.querySelector('.faq-a');
      if (!btn || !ans) return;
      btn.addEventListener('click', () => {
        const open = item.classList.contains('is-open');
        items.forEach(i => {
          i.classList.remove('is-open');
          const b = i.querySelector('.faq-q');
          const a = i.querySelector('.faq-a');
          if (b) b.setAttribute('aria-expanded', 'false');
          if (a) a.style.maxHeight = null;
        });
        if (!open) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          ans.style.maxHeight = ans.scrollHeight + 'px';
        }
      });
    });
  })();
</script>

<style>
.faq-layout {
  display: grid;
  grid-template-columns: minmax(0, 4.5fr) minmax(0, 7.5fr);
  gap: 64px 96px;
  align-items: start;
}

.faq-intro {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.faq-sub {
  font-family: var(--body);
  font-size: 15px;
  line-height: 1.7;
  color: var(--ink-soft);
  max-width: 36ch;
}
.faq-sub a {
  color: var(--accent-text);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}
.faq-sub a:hover { text-decoration-style: dotted; }

/* List */
.faq-list {
  border-top: 1px solid var(--line-strong);
}
.faq-item {
  border-bottom: 1px solid var(--line);
}

.faq-q {
  appearance: none;
  background: none;
  border: none;
  width: 100%;
  display: grid;
  grid-template-columns: 44px 1fr 32px;
  align-items: baseline;
  gap: 0;
  text-align: left;
  padding: 22px 0;
  cursor: pointer;
  font-family: var(--display);
  font-size: clamp(16px, 1.3vw, 18.5px);
  font-weight: 500;
  letter-spacing: -0.015em;
  line-height: 1.4;
  color: var(--ink);
  position: relative;
  transition: color .2s var(--ease);
}
.faq-q:hover { color: var(--accent-text); }
.faq-q:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }

.faq-q-no {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .06em;
  color: var(--ink-mute);
  padding-top: 3px;
}
.faq-q-text { padding-right: 16px; }

/* Plus icon */
.faq-q::after {
  content: "";
  justify-self: end;
  align-self: center;
  width: 14px; height: 14px;
  background:
    linear-gradient(var(--ink-mute), var(--ink-mute)) center / 100% 1.5px no-repeat,
    linear-gradient(var(--ink-mute), var(--ink-mute)) center / 1.5px 100% no-repeat;
  transition: transform .3s var(--ease);
  flex: none;
}
.faq-item.is-open .faq-q::after { transform: rotate(135deg); }
.faq-item.is-open .faq-q { color: var(--ink); }

.faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height .38s var(--ease);
}
.faq-a-inner {
  padding: 0 76px 26px 44px;
  font-family: var(--body);
  font-size: 15px;
  line-height: 1.75;
  color: var(--ink-soft);
  max-width: 68ch;
}

@media (max-width: 1080px) {
  .faq-layout { grid-template-columns: 1fr; gap: 40px; }
  .faq-intro { position: static; }
}
@media (max-width: 720px) {
  .faq-q { grid-template-columns: 30px 1fr 28px; padding: 18px 0; font-size: 15.5px; }
  .faq-a-inner { padding: 0 24px 22px 30px; font-size: 14px; }
}
</style>
