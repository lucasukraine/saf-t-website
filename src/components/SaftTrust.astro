---
// SaftTrust.astro — Trust / expertise / background section
import { getLang } from '../i18n';

const lang = getLang(Astro.url);
const t = {
  uk: {
    label: 'Досвід та відповідальність',
    h2: 'Чому обрати нас',
    lead: 'LUCAS розробляє SAF-T Connector і впроваджує його власними командами — фінансових консультантів і розробників. Немає розподілу відповідальності між постачальником програмного забезпечення та консультантами. Ми — єдиний центр відповідальності за продукт і його впровадження.',
    // Non-breaking hyphen in "SAF‑T UA": avoids an orphaned "T" at line end
    body: 'LUCAS має практичний досвід участі у пілотному проєкті з впровадження SAF‑T UA для великого міжнародного клієнта разом із представниками ДПС України. Цей досвід важливий, оскільки стандарт є великим і технічно складним стандартом, де успіх залежить від якості даних, логіки мапінгу, обліково-правових підходів, специфіки ERP та валідації. Продукт розроблений аудиторами та фінансовими консультантами для бухгалтерських і фінансових команд.',
    linkAria: 'Про компанію LUCAS — зовнішній сайт',
    link: 'Про компанію LUCAS',
    creds: [
      ['Власна розробка', 'LUCAS відповідає і за продукт, і за його впровадження'],
      ['Пілот ДПС', 'Команда з досвідом участі в пілотному проєкті'],
      ['Єдина команда', 'Фінансові консультанти та розробники LUCAS'],
      ['~3–4 міс.', 'Типовий термін впровадження'],
    ],
    badgesAria: 'Характеристики продукту',
    badges: [
      'Відповідність вимогам Мінфіну та ДПС',
      'Оновлення при зміні офіційної схеми',
      'Excel-перегляд',
      'Технічна підтримка та супровід',
      'Аудиторський та фінансовий досвід LUCAS',
      'Розгортання на інфраструктурі клієнта',
    ],
  },
  en: {
    label: 'Experience and accountability',
    h2: 'Why choose us',
    lead: 'LUCAS builds SAF-T Connector and implements it with its own teams of finance consultants and developers. Responsibility is never split between a software vendor and a consultancy: we are the single point of accountability for both the product and its implementation.',
    body: 'LUCAS has hands-on experience from a SAF‑T UA pilot implementation for a large international client, carried out together with representatives of the State Tax Service of Ukraine. That experience matters because SAF‑T UA is an extensive, technically complex standard, where success depends on data quality, mapping logic, accounting and legal judgment, ERP specifics and validation. The product was built by auditors and finance consultants for accounting and finance teams.',
    linkAria: 'About LUCAS — external website',
    link: 'About LUCAS',
    creds: [
      ['In-house product', 'LUCAS is responsible for both the product and its implementation'],
      ['STS pilot', 'A team with hands-on experience from the pilot project'],
      ['One team', 'LUCAS finance consultants and developers'],
      ['~3–4 months', 'Typical implementation time'],
    ],
    badgesAria: 'Product highlights',
    badges: [
      'Compliant with Ministry of Finance and STS requirements',
      'Updated when the official schema changes',
      'Excel view',
      'Technical support and maintenance',
      'LUCAS audit and finance expertise',
      'Deployed on the client\'s infrastructure',
    ],
  },
}[lang];
---

<section class="s-trust" id="trust" aria-labelledby="trust-h2">
  <div class="container">

    <div class="sect-rule">
      <span class="sect-no">06</span>
      <span class="sect-label">{t.label}</span>
    </div>

    <div class="trust-layout">

      <!-- Left: statement -->
      <div class="trust-statement">
        <h2 id="trust-h2" class="sect-h2">
          {t.h2}
        </h2>
        <p class="trust-lead">
          {t.lead}
        </p>
        <p class="trust-body">
          {t.body}
        </p>
        <a href="https://www.lucasua.com" target="_blank" rel="noopener" class="trust-link" aria-label={t.linkAria}>
          {t.link} <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Right: credentials — hairline stat table -->
      <div class="trust-creds">
        {t.creds.map(([val, lbl]) => (
          <div class="cred-card">
            <div class="cred-val">{val}</div>
            <div class="cred-lbl">{lbl}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Trust signals — single editorial row -->
    <div class="trust-badges" role="list" aria-label={t.badgesAria}>
      {t.badges.map((b) => <span class="trust-badge" role="listitem">{b}</span>)}
    </div>

  </div>
</section>

<style>
.trust-layout {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 96px;
  align-items: start;
  margin-bottom: 88px;
}

.trust-statement { display: flex; flex-direction: column; gap: 22px; }

.trust-lead {
  font-family: var(--body);
  font-size: clamp(16px, 1.25vw, 18px);
  line-height: 1.7;
  color: var(--ink);
  font-weight: 500;
}
.trust-body {
  font-family: var(--body);
  font-size: 15px;
  line-height: 1.75;
  color: var(--ink-soft);
}

.trust-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent-text);
  text-decoration: none;
  transition: gap .2s var(--ease);
  margin-top: 6px;
}
.trust-link:hover { gap: 12px; }
.trust-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }

/* Credentials — hairline stat table, no boxes */
.trust-creds {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}
.cred-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 26px 28px 30px 0;
  border-top: 1px solid var(--line-strong);
}
.cred-card:nth-child(even) { padding-left: 28px; border-left: 1px solid var(--line); padding-right: 0; }
.cred-val {
  font-family: var(--display);
  font-size: clamp(20px, 1.9vw, 26px);
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--ink);
  line-height: 1.1;
}
.cred-lbl {
  font-family: var(--body);
  font-size: 13px;
  line-height: 1.55;
  color: var(--ink-soft);
  max-width: 26ch;
}

/* Badges — single hairline row */
.trust-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 36px;
  border-top: 1px solid var(--line-strong);
  padding-top: 22px;
}
.trust-badge {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--body);
  font-size: 13px;
  font-weight: 500;
  color: var(--ink-soft);
  padding-left: 18px;
}
.trust-badge::before {
  content: "✓";
  position: absolute;
  left: 0;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  color: var(--accent-text);
}

@media (max-width: 1080px) {
  .trust-layout { grid-template-columns: 1fr; gap: 56px; margin-bottom: 64px; }
}
@media (max-width: 720px) {
  .trust-creds { grid-template-columns: 1fr; }
  .cred-card:nth-child(even) { padding-left: 0; border-left: none; }
  .cred-card { padding: 20px 0 24px; }
  .trust-badges { gap: 12px 24px; }
}
</style>
