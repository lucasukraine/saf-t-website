---
// Header.astro — SAF-T Connector
// Sticky header with transparent-over-dark-hero → scrolled-light transition
import { getLang, homePath, blogPath, switchTarget } from '../i18n';

const lang = getLang(Astro.url);
const home = homePath(lang);
const t = {
  uk: {
    homeAria: 'SAF-T Connector — на головну',
    navAria: 'Основна навігація',
    nav: ['Що таке SAF-T', 'ERP-системи', 'Реалізація', 'Валідація XML', 'Блог', 'FAQ', 'Контакти'],
    cta: 'Замовити демо',
    open: 'Відкрити меню',
    close: 'Закрити меню',
    menuAria: 'Навігаційне меню',
    menuNav: 'Навігація',
    menuAction: 'Дія',
    langAria: 'Мова сайту',
  },
  en: {
    homeAria: 'SAF-T Connector — home',
    navAria: 'Main navigation',
    nav: ['What is SAF-T', 'ERP systems', 'Implementation', 'XML validation', 'Blog', 'FAQ', 'Contact'],
    cta: 'Book a demo',
    open: 'Open menu',
    close: 'Close menu',
    menuAria: 'Navigation menu',
    menuNav: 'Navigation',
    menuAction: 'Action',
    langAria: 'Site language',
  },
}[lang];

// Root-relative links so they work from /blog/ pages too
const links = [
  `${home}#explainer`,
  `${home}#erp`,
  `${home}#how-it-works`,
  `${home}#validation`,
  blogPath(lang),
  `${home}#faq`,
  `${home}#contact`,
].map((href, i) => ({ href, label: t.nav[i] }));

const langs = [
  { code: 'uk', short: 'UA', name: 'Українська', href: switchTarget(Astro.url.pathname, 'uk') },
  { code: 'en', short: 'EN', name: 'English', href: switchTarget(Astro.url.pathname, 'en') },
] as const;
---

<header class="header" id="header">
  <div class="header-inner">

    <!-- Logo — base-aware href works under any subpath or root -->
    <a href={home} class="logo" aria-label={t.homeAria}>
      <img src={`${import.meta.env.BASE_URL}logo-white.svg`} class="logo-img logo-img-white" alt="SAF-T Connector" width="133" height="36" fetchpriority="high" />
      <img src={`${import.meta.env.BASE_URL}logo.svg`} class="logo-img logo-img-color" alt="" width="133" height="36" />
    </a>

    <!-- Desktop nav -->
    <nav class="nav" aria-label={t.navAria}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <!-- Actions -->
    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label={t.langAria}>
        {langs.map((l, i) => (<>
          {i > 0 && <span class="lang-sep" aria-hidden="true"></span>}
          {l.code === lang
            ? <span class="lang-opt is-current" lang={l.code} aria-current="true" title={l.name}>{l.short}</span>
            : <a class="lang-opt" href={l.href} hreflang={l.code} lang={l.code} title={l.name} aria-label={l.name} data-set-lang={l.code}>{l.short}</a>}
        </>))}
      </div>
      <a class="header-cta" href={`${home}#contact`}>{t.cta}</a>
      <button
        aria-expanded="false"
        aria-label={t.open}
        class="mob-menu-btn"
        id="mob-menu-btn"
        data-label-open={t.open}
        data-label-close={t.close}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile slide-in panel -->
<div inert class="mob-menu" id="mob-menu" role="dialog" aria-modal="true" aria-label={t.menuAria}>
  <!-- Top row: language switch first, then the close button (the burger
       sits under the panel while it is open) -->
  <div class="mob-top">
    <div class="mob-lang" role="group" aria-label={t.langAria}>
      {langs.map((l) => (
        l.code === lang
          ? <span class="mob-lang-opt is-current" lang={l.code} aria-current="true">{l.name}</span>
          : <a class="mob-lang-opt" href={l.href} hreflang={l.code} lang={l.code} data-set-lang={l.code}>{l.name}</a>
      ))}
    </div>
    <button type="button" class="mob-close" id="mob-close" aria-label={t.close}>
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <span class="mob-section-label">{t.menuNav}</span>
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
  <span class="mob-section-label">{t.menuAction}</span>
  <a href={`${home}#contact`} class="mob-cta-link">{t.cta} →</a>
</div>

<div class="mob-overlay" id="mob-overlay"></div>

<style>
  .mob-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(215,228,248,.08);
  }
  .mob-lang {
    display: inline-flex;
    border: 1px solid rgba(215,228,248,.16);
    border-radius: 8px;
    padding: 3px;
  }
  .mob-menu .mob-lang-opt {
    display: block;
    padding: 7px 12px;
    border: none;
    border-radius: 5px;
    font-family: var(--body);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0;
    color: rgba(232,238,250,.62);
  }
  .mob-menu .mob-lang-opt.is-current { background: rgba(255,255,255,.10); color: #fff; }
  .mob-menu a.mob-lang-opt:hover { color: #fff; }
  .mob-close {
    flex: none;
    width: 40px; height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid rgba(215,228,248,.16);
    border-radius: 8px;
    color: rgba(232,238,250,.82);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .mob-close:hover { color: #fff; border-color: rgba(215,228,248,.32); }
  .mob-close:focus-visible,
  .mob-menu a.mob-lang-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .mob-menu .mob-cta-link {
    color: #fff;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .mob-menu .mob-cta-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>

<script is:inline>
  (() => {
    const header = document.getElementById('header');
    if (!header) return;

    const syncHeader = () => {
      const light = document.body.classList.contains('theme-light');
      header.classList.toggle('scrolled', light);
    };

    // Watch body class changes (set by theme-zone script in BaseLayout)
    new MutationObserver(syncHeader).observe(document.body, {
      attributes: true, attributeFilter: ['class']
    });
    syncHeader();
  })();

  (() => {
    const btn     = document.getElementById('mob-menu-btn');
    const menu    = document.getElementById('mob-menu');
    const overlay = document.getElementById('mob-overlay');
    if (!btn || !menu || !overlay) return;

    // Modal behaviour: while the menu is open, everything behind it is inert
    // (unreachable by Tab and screen readers) and Tab cycles between the
    // menu's own controls. Focus returns to the burger button on close.
    const background = () => [
      document.getElementById('main-content'),
      document.querySelector('footer'),
      document.querySelector('.skip-link'),
      ...document.querySelectorAll('.header .logo, .header .nav, .header .lang-switch, .header .header-cta'),
    ].filter(Boolean);
    const isOpen = () => menu.classList.contains('is-open');

    const open = () => {
      btn.classList.add('is-open');
      menu.classList.add('is-open');
      overlay.classList.add('is-open');
      menu.removeAttribute('inert');
      background().forEach(el => { el.inert = true; });
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', btn.dataset.labelClose);
      document.body.style.overflow = 'hidden';
      const first = menu.querySelector('a');
      if (first) first.focus();
    };
    const close = (returnFocus) => {
      if (!isOpen()) return;
      btn.classList.remove('is-open');
      menu.classList.remove('is-open');
      overlay.classList.remove('is-open');
      menu.setAttribute('inert', '');
      background().forEach(el => { el.inert = false; });
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', btn.dataset.labelOpen);
      document.body.style.overflow = '';
      if (returnFocus) btn.focus();
    };

    const closeBtn = document.getElementById('mob-close');
    if (closeBtn) closeBtn.addEventListener('click', () => close(true));
    btn.addEventListener('click', () => (isOpen() ? close(true) : open()));
    overlay.addEventListener('click', () => close(true));
    // A link navigates (or jumps to an anchor), so focus follows it
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => close(false)));
    document.addEventListener('keydown', e => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { close(true); return; }
      if (e.key !== 'Tab') return;
      const cycle = [...menu.querySelectorAll('a, button')];
      const i = cycle.indexOf(document.activeElement);
      const next = e.shiftKey
        ? (i <= 0 ? cycle.length - 1 : i - 1)
        : (i === -1 || i === cycle.length - 1 ? 0 : i + 1);
      e.preventDefault();
      cycle[next].focus();
    });
  })();

  // An explicit language choice wins over the automatic redirect to /en/
  // (see BaseLayout): remember it for later visits.
  document.querySelectorAll('[data-set-lang]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('saft-lang', a.dataset.setLang); } catch (e) {}
    });
  });
</script>
