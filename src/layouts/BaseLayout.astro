---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getLang, alternatesFor, htmlLang, ogLocale, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
  schemaExtra?: string;
  /** 'auto' — scroll-driven dark/light zones (landing). 'light' — fixed light theme (blog). */
  theme?: 'auto' | 'light';
  /** OpenGraph type; articles pass 'article' + timestamps. */
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  /** CSS selectors of the page's own quotable lead content, for WebPage.speakable. */
  speakableSelectors?: string[];
}

const lang: Lang = getLang(Astro.url);

const defaults = {
  uk: {
    title: 'SAF-T Connector — формування та валідація SAF-T UA файлів',
    description: 'SAF-T Connector формує XML-файли SAF-T UA з SAP, BAS/1C, Odoo та Excel. Вбудована XSD-валідація за схемою ДПС. Готовий стандартний аудиторський файл для ДПС України.',
  },
  en: {
    title: 'SAF-T Connector — SAF-T UA file generation and validation',
    description: 'SAF-T Connector builds SAF-T UA XML files from SAP, BAS/1C, Odoo and Excel, with built-in XSD validation against the schema of the State Tax Service of Ukraine.',
  },
}[lang];

const {
  title = defaults.title,
  description = defaults.description,
  canonical,
  noIndex = false,
  schemaExtra,
  theme = 'auto',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  speakableSelectors,
} = Astro.props;

// Dynamic site URL — driven by astro.config.mjs `site` value.
// Production: 'https://saftconnector.com' (custom domain on GitHub Pages)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://saftconnector.com';
const base = import.meta.env.BASE_URL; // e.g. '/saf-t-website/' or '/'

const canonicalUrl = canonical ?? (siteUrl + Astro.url.pathname.replace(/\/$/, '') + '/').replace(/\/\/$/, '/');
const ogImage = Astro.props.ogImage ?? `${siteUrl}/${lang === 'en' ? 'og-image-en.jpg' : 'og-image.jpg'}`;

// hreflang pairs — only for pages that exist in both languages (home, blog
// index). Ukrainian articles have no English counterpart, so they get none.
const alternates = alternatesFor(Astro.url.pathname);

// Automatically add noindex when deployed to a *.github.io preview URL.
// On production (saftconnector.com) noindex is never added unless explicitly set.
const isGithubPages = Astro.site?.hostname.endsWith('.github.io') ?? false;
const effectiveNoIndex = noIndex || isGithubPages;

// Build date doubles as the page's dateModified — the static site is
// rebuilt on every content change, so this is truthful.
const buildDate = new Date().toISOString().split('T')[0];

// Locale copy for schema and chrome strings
const loc = {
  uk: {
    orgDescription: 'Програмне рішення для автоматичного формування, валідації та експорту файлів SAF-T UA відповідно до вимог ДПС України.',
    street: 'БЦ Гулівер, вежа А, 17-й поверх',
    city: 'Київ',
    softwareDescription: 'SAF-T Connector — програмне рішення для автоматичного формування XML-файлів SAF-T UA, XSD-валідації та подачі до ДПС України. Підтримує SAP, BAS/1C, Oracle, Microsoft Dynamics, Odoo та інші ERP-системи.',
    features: [
      'Автоматичне формування XML-файлу SAF-T UA з облікових даних',
      'XSD-валідація за офіційною схемою ДПС',
      'Математичні, бухгалтерські та міжсекційні контролі',
      'Excel-перегляд аудиторського файлу',
      'Інтеграція з SAP, BAS/1C, Microsoft Dynamics, Oracle, Odoo, Excel/CSV',
      'Розгортання на інфраструктурі клієнта (Docker)',
    ],
    audience: 'Бухгалтери, IT-директори, фінансові директори великих та середніх підприємств',
    launch: '2026-07-15',
    skip: 'Перейти до основного вмісту',
    rss: 'SAF-T Connector — Блог',
  },
  en: {
    orgDescription: 'Software for automated generation, validation and export of SAF-T UA files in line with the requirements of the State Tax Service of Ukraine.',
    street: 'Gulliver Business Center, Tower A, 17th floor',
    city: 'Kyiv',
    softwareDescription: 'SAF-T Connector is a software solution for automated generation of SAF-T UA XML files, XSD validation and submission to the State Tax Service of Ukraine. It supports SAP, BAS/1C, Oracle, Microsoft Dynamics, Odoo and other ERP systems.',
    features: [
      'Automated generation of the SAF-T UA XML file from accounting data',
      'XSD validation against the official STS schema',
      'Arithmetic and accounting consistency checks, cross-checks between file sections',
      'Excel view of the audit file',
      'Integration with SAP, BAS/1C, Microsoft Dynamics, Oracle, Odoo, Excel/CSV',
      'Deployment on the client\'s infrastructure (Docker)',
    ],
    audience: 'Accountants, CIOs and CFOs of large and mid-sized companies',
    // Date the English version went live
    launch: '2026-11-23',
    skip: 'Skip to main content',
    rss: 'SAF-T Connector — Blog (in Ukrainian)',
  },
}[lang];

const orgSchema = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'SAF-T Connector',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/logo.png`,
    width: 600,
    height: 164,
  },
  description: loc.orgDescription,
  areaServed: 'UA',
  address: {
    '@type': 'PostalAddress',
    streetAddress: loc.street,
    addressLocality: loc.city,
    addressCountry: 'UA',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+380443447915',
    contactType: 'sales',
    areaServed: 'UA',
    availableLanguage: ['Ukrainian', 'English'],
  },
  sameAs: ['https://www.linkedin.com/company/lucasukraine/'],
  parentOrganization: {
    '@type': 'Organization',
    name: 'LUCAS',
    url: 'https://www.lucasua.com',
  },
};

const softwareSchema = {
  '@type': 'SoftwareApplication',
  '@id': `${siteUrl}/#software`,
  name: 'SAF-T Connector',
  url: siteUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Cloud, Windows',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
  },
  description: loc.softwareDescription,
  featureList: loc.features,
  screenshot: ogImage,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: 'uk',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: loc.audience,
  },
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'SAF-T Connector',
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: ['uk', 'en'],
};

const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#software` },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
  ...(speakableSelectors && {
    speakable: { '@type': 'SpeakableSpecification', cssSelector: speakableSelectors },
  }),
  // Falls back to the homepage's own launch date when a page (e.g. a blog
  // article) doesn't pass its real publishedTime/modifiedTime — otherwise
  // every page would incorrectly claim the homepage's date.
  datePublished: publishedTime ?? loc.launch,
  dateModified: modifiedTime ?? buildDate,
  inLanguage: lang,
};

const combinedSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [orgSchema, softwareSchema, websiteSchema, webPageSchema],
});
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#03a9f4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="uk" href={siteUrl + alternates.uk} />
        <link rel="alternate" hreflang="en" href={siteUrl + alternates.en} />
        <link rel="alternate" hreflang="x-default" href={siteUrl + alternates.uk} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={loc.rss} href={`${base}rss.xml`} />
    {effectiveNoIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:site_name" content="SAF-T Connector" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates && <meta property="og:locale:alternate" content={ogLocale[lang === 'en' ? 'uk' : 'en']} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons — SVG primary + PNG fallbacks for crawlers/devices.
         48x48 (not 32x32) per Google's favicon guidance: square, multiple of 48px. -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}favicon-48.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />

    <!-- Font preload — LCP-critical subsets. English pages render Cyrillic only
         below the fold (Ukrainian article titles), so they skip those preloads;
         unicode-range still fetches them on demand. -->
    {lang === 'uk' && <link rel="preload" href={`${base}fonts/onest/onest-cyrillic.woff2`} as="font" type="font/woff2" crossorigin fetchpriority="high" />}
    <link rel="preload" href={`${base}fonts/onest/onest-latin.woff2`} as="font" type="font/woff2" crossorigin fetchpriority="high" />
    {lang === 'uk' && <link rel="preload" href={`${base}fonts/manrope/manrope-cyrillic.woff2`} as="font" type="font/woff2" crossorigin fetchpriority="high" />}
    <link rel="preload" href={`${base}fonts/manrope/manrope-latin.woff2`} as="font" type="font/woff2" crossorigin fetchpriority="high" />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={combinedSchema} />
    {schemaExtra && <script type="application/ld+json" is:inline set:html={schemaExtra} />}

    <slot name="head" />
  </head>
  <body class={theme === 'light' ? 'theme-light' : 'theme-dark'}>
    <a class="skip-link" href="#main-content">{loc.skip}</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {theme === 'auto' && <script is:inline>
      (function () {
        // Theme alternates every 2 sections: dark(hero, explainer) → light(benefits, erp)
        // → dark(how-it-works, validation) → light(trust, faq) → dark(materials, contact)
        var LIGHT_IDS = ['benefits', 'erp', 'trust', 'faq'];
        var ZONE_IDS  = ['hero', 'explainer', 'benefits', 'erp', 'how-it-works', 'validation', 'trust', 'faq', 'materials', 'contact'];
        var zones = [];

        var updateTheme = function () {
          var mid = window.innerHeight * 0.5;
          var active = 'hero';
          var found = false;
          // Primary: section that contains the midpoint (top ≤ mid < bottom)
          for (var i = 0; i < zones.length; i++) {
            var r = zones[i].el.getBoundingClientRect();
            if (r.top <= mid && r.bottom > mid) { active = zones[i].id; found = true; break; }
          }
          // Fallback: last section whose top crossed midpoint (handles gaps / very end of page)
          if (!found) {
            for (var j = 0; j < zones.length; j++) {
              if (zones[j].el.getBoundingClientRect().top <= mid) active = zones[j].id;
            }
          }
          var light = LIGHT_IDS.indexOf(active) !== -1;
          document.body.classList.toggle('theme-light', light);
          document.body.classList.toggle('theme-dark',  !light);
        };

        var init = function () {
          zones = ZONE_IDS.map(function (id) {
            var el = document.getElementById(id);
            return el ? { id: id, el: el } : null;
          }).filter(Boolean);
          window.addEventListener('scroll', updateTheme, { passive: true });
          window.addEventListener('resize', updateTheme);
          updateTheme();
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>}
    <script is:inline>
      // Anti-spam email reveal: address is split into data-user/data-domain
      // in the markup and only assembled into a real mailto link on click,
      // so it never appears as plain text in the server-rendered HTML.
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.email-reveal');
        if (!btn) return;
        var user = btn.dataset.user;
        var domain = btn.dataset.domain;
        if (!user || !domain) return;
        var email = user + '@' + domain;
        var link = document.createElement('a');
        link.href = 'mailto:' + email;
        link.className = btn.className.replace('email-reveal', '').trim();
        link.textContent = email;
        btn.replaceWith(link);
        link.focus();
      });
    </script>
  </body>
</html>
